# Postgres connection string. Neon (via Vercel Storage) sets this for you.
# Supabase: use the "Transaction pooler" string (port 6543).
DATABASE_URL=postgres://user:password@host:5432/dbname
# PIN for the projector screen at /host
HOST_PIN=change-me
# Optional: force the URL shown in the QR code (e.g. a custom domain)
PUBLIC_URL=
# Optional fallback for the networking screen: a Linktree (or any) URL.
# Only used when no mentor links have been added from the host screen, which is the
# better option - see "Networking at the end" in the README. Leave blank to use neither.
NETWORK_URL=
